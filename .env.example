# Optional settings. Copy this file to ".env" (same folder) and edit; both
# "docker compose" and scripts/start.sh read it. Everything here has a default.

# Where the archive is written. About 2.5 to 5 GB a day for the US stations.
# Examples: /mnt/bigdisk/polyweather   D:/polyweather
#POLYWEATHER_DATA_DIR=./data

# "us" = the 11 US stations; "all" = all 48 stations (several times the volume).
#POLYWEATHER_SCOPE=us

# Slack or Discord incoming-webhook URL for failure alerts. Keep it out of git:
# ".env" is ignored by git, this example file is not.
#ALERT_WEBHOOK_URL=
