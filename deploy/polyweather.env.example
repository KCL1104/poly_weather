# Copy to /etc/polyweather.env (install.sh does this once and never overwrites it).
POLYWEATHER_DATA_DIR=/var/lib/polyweather
# "us" = the 11 US stations (highs and lows); "all" = every station in the registry.
POLYWEATHER_SCOPE=us
POLYWEATHER_USER_AGENT=polyweather-research/0.1
# Optional: Slack or Discord incoming-webhook URL for failure alerts.
ALERT_WEBHOOK_URL=
