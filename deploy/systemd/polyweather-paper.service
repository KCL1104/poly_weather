[Unit]
Description=polyweather: advance the paper ledgers
After=network-online.target
Wants=network-online.target
OnFailure=polyweather-alert@%n.service

[Service]
Type=oneshot
User=polyweather
Group=polyweather
WorkingDirectory=/opt/polyweather
EnvironmentFile=/etc/polyweather.env
ExecStart=/opt/polyweather/.venv/bin/polyweather paper run
TimeoutStartSec=1800
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/polyweather
