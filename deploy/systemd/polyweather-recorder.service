[Unit]
Description=polyweather: order-book recorder
After=network-online.target
Wants=network-online.target
OnFailure=polyweather-alert@%n.service

[Service]
Type=simple
User=polyweather
Group=polyweather
WorkingDirectory=/opt/polyweather
EnvironmentFile=/etc/polyweather.env
ExecStart=/opt/polyweather/.venv/bin/polyweather record
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/polyweather

[Install]
WantedBy=multi-user.target
